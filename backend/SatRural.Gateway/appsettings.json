{
  "Jwt": {
    "Issuer": "SatRural.Api",
    "Audience": "SatRural.Client"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-service",
        "Order": 0,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "reports-health-route": {
        "ClusterId": "report-service",
        "Order": 0,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/reports/health"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/reports"
          }
        ]
      },
      "reports-route": {
        "ClusterId": "report-service",
        "Order": 1,
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/reports/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/reports"
          }
        ]
      },
      "api-route": {
        "ClusterId": "legacy-api",
        "Order": 10,
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "hubs-route": {
        "ClusterId": "legacy-api",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "legacy-api": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8080/"
          }
        }
      },
      "auth-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8082/"
          }
        }
      },
      "report-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8000/"
          }
        }
      }
    }
  }
}