{
  "Jwt": {
    "Issuer": "SatRural.Api",
    "Audience": "SatRural.Client"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-next",
        "Order": 0,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "auth-next-staging-route": {
        "ClusterId": "auth-next",
        "Order": 0,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/auth-next/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/auth-next"
          }
        ]
      },
      "reports-health-route": {
        "ClusterId": "report-service",
        "Order": 0,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/reports/health"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/reports"
          }
        ]
      },
      "reports-route": {
        "ClusterId": "report-service",
        "Order": 1,
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/reports/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/reports"
          }
        ]
      },
      "communities-route": {
        "ClusterId": "community-service",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/communities/{**catch-all}"
        }
      },
      "sensor-readings-route": {
        "ClusterId": "sensor-service",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/sensor-readings/{**catch-all}"
        }
      },
      "monitoring-route": {
        "ClusterId": "sensor-service",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/monitoring/{**catch-all}"
        }
      },
      "alerts-route": {
        "ClusterId": "alert-service",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/alerts/{**catch-all}"
        }
      },
      "alert-rules-route": {
        "ClusterId": "alert-service",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/alert-rules/{**catch-all}"
        }
      },
      "events-route": {
        "ClusterId": "alert-service",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/events/{**catch-all}"
        }
      },
      "binnacle-route": {
        "ClusterId": "audit-service",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/binnacle/{**catch-all}"
        }
      },
      "audit-logs-route": {
        "ClusterId": "audit-service",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/audit-logs/{**catch-all}"
        }
      },
      "community-service-staging-route": {
        "ClusterId": "community-service",
        "Order": 0,
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/community-service/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/community-service"
          }
        ]
      },
      "alert-service-rules-write-route": {
        "ClusterId": "alert-service",
        "Order": -1,
        "AuthorizationPolicy": "Admin",
        "Match": {
          "Path": "/alert-service/api/alert-rules/{**catch-all}",
          "Methods": ["POST", "PUT", "DELETE"]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/alert-service"
          }
        ]
      },
      "alert-service-resolve-route": {
        "ClusterId": "alert-service",
        "Order": -1,
        "AuthorizationPolicy": "Operator",
        "Match": {
          "Path": "/alert-service/api/alerts/{**catch-all}",
          "Methods": ["PATCH"]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/alert-service"
          }
        ]
      },
      "alert-service-staging-route": {
        "ClusterId": "alert-service",
        "Order": 0,
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/alert-service/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/alert-service"
          }
        ]
      },
      "audit-service-staging-route": {
        "ClusterId": "audit-service",
        "Order": 0,
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/audit-service/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/audit-service"
          }
        ]
      },
      "sensor-ingest-route": {
        "ClusterId": "sensor-service",
        "Order": 0,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/sensors/readings",
          "Methods": ["POST"]
        }
      },
      "sensor-route": {
        "ClusterId": "sensor-service",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/sensors/{**catch-all}"
        }
      },
      "sensor-service-staging-route": {
        "ClusterId": "sensor-service",
        "Order": 1,
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/sensor-service/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/sensor-service"
          }
        ]
      }
    },
    "Clusters": {
      "auth-next": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8086/"
          }
        }
      },
      "report-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8000/"
          }
        }
      },
      "community-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://community-service:8080/"
          }
        }
      },
      "sensor-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://sensor-service:8080/"
          }
        }
      },
      "alert-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8085/"
          }
        }
      },
      "audit-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8001/"
          }
        }
      }
    }
  }
}
