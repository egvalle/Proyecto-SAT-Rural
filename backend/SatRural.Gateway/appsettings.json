{
  "Jwt": {
    "Issuer": "SatRural.Api",
    "Audience": "SatRural.Client"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "legacy-api",
        "Order": 0,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "api-route": {
        "ClusterId": "legacy-api",
        "Order": 10,
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "hubs-route": {
        "ClusterId": "legacy-api",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "legacy-api": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8080/"
          }
        }
      }
    }
  }
}